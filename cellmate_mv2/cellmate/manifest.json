{
  "manifest_version": 2,
  "name": "Cellmate",
  "version": "1.0",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["domMonitor.js", "functionExecutor.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "prediction.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}